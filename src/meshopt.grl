module meshopt;
use hashmap;

// A port of meshoptimizer 1.3 (https://github.com/zeux/meshoptimizer, MIT) with results identical
// to the C++ library built without floating-point contraction (-ffp-contract=off), as Abundance
// builds it. Positions are flat f32 arrays with a stride in floats.

pub struct Bounds {
    center: f32[],
    radius: f32,
    cone_apex: f32[],
    cone_axis: f32[],
    cone_cutoff: f32,
    cone_axis_s8: i64[],
    cone_cutoff_s8: i64
}

// A vertex attribute stream for generate_vertex_remap_multi: `size` bytes per vertex, `stride`
// bytes apart.
pub struct Stream {
    data: u8[],
    size: u64,
    stride: u64
}

fn empty_bounds() -> Bounds {
    return Bounds { center: f32[0.0, 0.0, 0.0], radius: 0.0, cone_apex: f32[0.0, 0.0, 0.0], cone_axis: f32[0.0, 0.0, 0.0], cone_cutoff: 0.0, cone_axis_s8: i64[0, 0, 0], cone_cutoff_s8: 0 };
}

// ---- remaps ----

// Position key that compares like C floats: -0 and +0 are equal; NaN equals nothing.
fn position_key<a>(p: (&a f32[]), at: u64) -> u8[]? {
    mut key = u8[];
    for c in 3 {
        v := p[at + c];
        if v != v {
            return None;
        }
        mut b = f32_bits(v);
        if v == 0.0 {
            b = 0;
        }
        for k in 4 {
            key.push((b >> (k * 8)) & 255);
        }
    }
    return Some(key);
}

// For each vertex, the first vertex with an identical position (meshopt_generatePositionRemap).
pub fn generate_position_remap<a>(positions: (&a f32[]), vertex_count: u64, stride: u64) -> u64[] {
    mut first = [u8[]: u64]();
    mut out = u64[];
    for i in vertex_count {
        match position_key(&positions, i * stride) {
            Some(key) => {
                mut hit: u64 = 18446744073709551615;
                match first.get(&key) {
                    Some(j) => { hit = load(j); },
                    None => { }
                }
                if hit == 18446744073709551615 {
                    first.insert(key, i);
                    out.push(i);
                } else {
                    out.push(hit);
                }
            },
            None => { out.push(i); }
        }
    }
    return out;
}

// meshopt_generateVertexRemapMulti: remap[v] numbers unique vertices (byte-identical in every
// stream) in order of first use by `indices` (or 0..vertex_count when indices is empty and
// index_count == vertex_count); unused vertices map to 4294967295. Returns (remap, unique count).
pub fn generate_vertex_remap_multi<a, b>(indices: (&a u64[]), index_count: u64, vertex_count: u64, streams: (&b Stream[])) -> u64[] {
    mut remap = u64[];
    for i in vertex_count {
        remap.push(4294967295);
    }
    mut seen = [u8[]: u64]();
    mut next: u64 = 0;
    for i in index_count {
        mut index = i;
        if indices.len() != 0 {
            index = indices[i];
        }
        if remap[index] != 4294967295 {
            continue;
        }
        mut key = u8[];
        for s in streams.len() {
            st := &streams[s];
            base := index * st.stride;
            for k in st.size {
                key.push(st.data[base + k]);
            }
        }
        mut hit: u64 = 18446744073709551615;
        match seen.get(&key) {
            Some(r) => { hit = load(r); },
            None => { }
        }
        if hit == 18446744073709551615 {
            seen.insert(key, next);
            remap[index] = next;
            next += 1;
        } else {
            remap[index] = hit;
        }
    }
    remap.push(next);
    return remap;
}

// ---- bounds ----

fn axis_value(axis: u64, c: u64) -> f32 {
    k: f32 := 0.57735026;
    if axis < 3 {
        if axis == c {
            return 1.0;
        }
        return 0.0;
    }
    // XYZ, -XYZ, X-YZ, XY-Z
    if (axis == 4) && (c == 0) {
        return 0.0 - k;
    }
    if (axis == 5) && (c == 1) {
        return 0.0 - k;
    }
    if (axis == 6) && (c == 2) {
        return 0.0 - k;
    }
    return k;
}

// computeBoundingSphere: points p (stride ps floats), radii r (stride rs floats, rs 0 = all
// r[0]), optionally through `indices` (empty = 0..count).
// Which points bounding_sphere visits: indices[0..count], or 0..count when indices is empty.
struct Selection {
    indices: u64[],
    count: u64
}

fn bounding_sphere<a, b, c>(p: (&a f32[]), ps: u64, r: (&b f32[]), rs: u64, axis_count: u64, sel: (&c Selection)) -> f32[] {
    indices := &sel.indices;
    count := sel.count;
    flt_max: f32 := 340282346638528859811704183484516925440.0;
    mut pmin = u64[0, 0, 0, 0, 0, 0, 0];
    mut pmax = u64[0, 0, 0, 0, 0, 0, 0];
    mut tmin = f32[];
    mut tmax = f32[];
    for a in 7 {
        tmin.push(flt_max);
        tmax.push(0.0 - flt_max);
    }
    for i in count {
        mut v = i;
        if indices.len() != 0 {
            v = indices[i];
        }
        x := p[v * ps];
        y := p[v * ps + 1];
        z := p[v * ps + 2];
        rad := r[v * rs];
        for a in axis_count {
            tp: f32 := axis_value(a, 0) * x + axis_value(a, 1) * y + axis_value(a, 2) * z;
            tpmin := tp - rad;
            tpmax := tp + rad;
            if tpmin < tmin[a] {
                pmin[a] = v;
                tmin[a] = tpmin;
            }
            if tpmax > tmax[a] {
                pmax[a] = v;
                tmax[a] = tpmax;
            }
        }
    }
    mut paxis: u64 = 0;
    mut paxisdr: f32 = 0.0;
    for a in axis_count {
        i1 := pmin[a] * ps;
        i2 := pmax[a] * ps;
        r1 := r[pmin[a] * rs];
        r2 := r[pmax[a] * rs];
        dx := p[i2] - p[i1];
        dy := p[i2 + 1] - p[i1 + 1];
        dz := p[i2 + 2] - p[i1 + 2];
        d2: f32 := dx * dx + dy * dy + dz * dz;
        dr: f32 := d2.sqrt() + r1 + r2;
        if dr > paxisdr {
            paxisdr = dr;
            paxis = a;
        }
    }
    i1 := pmin[paxis] * ps;
    i2 := pmax[paxis] * ps;
    r1 := r[pmin[paxis] * rs];
    r2 := r[pmax[paxis] * rs];
    dx := p[i2] - p[i1];
    dy := p[i2 + 1] - p[i1 + 1];
    dz := p[i2 + 2] - p[i1 + 2];
    sq: f32 := dx * dx + dy * dy + dz * dz;
    paxisd: f32 := sq.sqrt();
    mut paxisk: f32 = 0.0;
    if paxisd > 0.0 {
        two: f32 := 2.0;
        paxisk = (paxisd + r2 - r1) / (two * paxisd);
    }
    mut cx: f32 = p[i1] + (p[i2] - p[i1]) * paxisk;
    mut cy: f32 = p[i1 + 1] + (p[i2 + 1] - p[i1 + 1]) * paxisk;
    mut cz: f32 = p[i1 + 2] + (p[i2 + 2] - p[i1 + 2]) * paxisk;
    half: f32 := 2.0;
    mut radius: f32 = paxisdr / half;
    for i in count {
        mut v = i;
        if indices.len() != 0 {
            v = indices[i];
        }
        x := p[v * ps];
        y := p[v * ps + 1];
        z := p[v * ps + 2];
        rad := r[v * rs];
        ex := x - cx;
        ey := y - cy;
        ez := z - cz;
        d2: f32 := ex * ex + ey * ey + ez * ez;
        d: f32 := d2.sqrt();
        if d + rad > radius {
            mut k: f32 = 0.0;
            if d > 0.0 {
                two: f32 := 2.0;
                k = (d + rad - radius) / (two * d);
            }
            cx += k * (x - cx);
            cy += k * (y - cy);
            cz += k * (z - cz);
            radius = (radius + d + rad) / half;
        }
    }
    return f32[cx, cy, cz, radius];
}

// meshopt_computeSphereBounds: radii empty for points (radius 0), otherwise radius of element i at
// radii[i * radii_stride].
pub fn compute_sphere_bounds<a, b>(positions: (&a f32[]), count: u64, stride: u64, radii: (&b f32[]), radii_stride: u64) -> Bounds {
    mut b = empty_bounds();
    if count == 0 {
        return b;
    }
    zero := f32[0.0];
    all := Selection { indices: u64[], count: count };
    mut s = f32[];
    if radii.len() == 0 {
        s = bounding_sphere(&positions, stride, &zero, 0, 7, &all);
    } else {
        s = bounding_sphere(&positions, stride, &radii, radii_stride, 7, &all);
    }
    b.center = f32[s[0], s[1], s[2]];
    b.radius = s[3];
    return b;
}

fn quantize_snorm(v: f32, n: u64) -> i64 {
    scale: f32 := f32(i64(1 << (n - 1)) - 1);
    mut round: f32 = 0.5;
    if (v >= 0.0) == false {
        round = 0.0 - round;
    }
    mut x = v;
    if (x >= -1.0) == false {
        x = -1.0;
    }
    if (x <= 1.0) == false {
        x = 1.0;
    }
    return i64(x * scale + round);
}

fn cluster_bounds<a, b, c>(indices: (&a u64[]), corners: (&b u64[]), positions: (&c f32[]), stride: u64) -> Bounds {
    mut normals = f32[];
    mut triangles: u64 = 0;
    mut i: u64 = 0;
    while i < indices.len() {
        a := indices[i] * stride;
        b := indices[i + 1] * stride;
        c := indices[i + 2] * stride;
        i += 3;
        p10x := positions[b] - positions[a];
        p10y := positions[b + 1] - positions[a + 1];
        p10z := positions[b + 2] - positions[a + 2];
        p20x := positions[c] - positions[a];
        p20y := positions[c + 1] - positions[a + 1];
        p20z := positions[c + 2] - positions[a + 2];
        mut nx: f32 = p10y * p20z - p10z * p20y;
        mut ny: f32 = p10z * p20x - p10x * p20z;
        mut nz: f32 = p10x * p20y - p10y * p20x;
        sq: f32 := nx * nx + ny * ny + nz * nz;
        area: f32 := sq.sqrt();
        if area == 0.0 {
            continue;
        }
        nx = nx / area;
        ny = ny / area;
        nz = nz / area;
        normals.push(nx);
        normals.push(ny);
        normals.push(nz);
        w: f32 := nx * positions[a] + ny * positions[a + 1] + nz * positions[a + 2];
        normals.push(0.0 - w);
        triangles += 1;
    }
    mut bounds = empty_bounds();
    if triangles == 0 {
        return bounds;
    }
    zero := f32[0.0];
    mut cidx = u64[];
    for k in corners.len() {
        cidx.push(corners[k]);
    }
    csel := Selection { indices: cidx, count: corners.len() };
    psphere := bounding_sphere(&positions, stride, &zero, 0, 7, &csel);
    tsel := Selection { indices: u64[], count: triangles };
    nsphere := bounding_sphere(&normals, 4, &zero, 0, 3, &tsel);
    mut ax: f32 = nsphere[0];
    mut ay: f32 = nsphere[1];
    mut az: f32 = nsphere[2];
    al2: f32 := ax * ax + ay * ay + az * az;
    axislength: f32 := al2.sqrt();
    mut inv: f32 = 0.0;
    if axislength != 0.0 {
        one: f32 := 1.0;
        inv = one / axislength;
    }
    ax = ax * inv;
    ay = ay * inv;
    az = az * inv;
    mut mindp: f32 = 1.0;
    for t in triangles {
        dp: f32 := normals[t * 4] * ax + normals[t * 4 + 1] * ay + normals[t * 4 + 2] * az;
        if dp < mindp {
            mindp = dp;
        }
    }
    bounds.center = f32[psphere[0], psphere[1], psphere[2]];
    bounds.radius = psphere[3];
    cutoff_min: f32 := 0.1;
    if mindp <= cutoff_min {
        bounds.cone_cutoff = 1.0;
        bounds.cone_cutoff_s8 = 127;
        return bounds;
    }
    mut maxt: f32 = 0.0;
    for t in triangles {
        dc: f32 := psphere[0] * normals[t * 4] + psphere[1] * normals[t * 4 + 1] + psphere[2] * normals[t * 4 + 2] + normals[t * 4 + 3];
        dn: f32 := ax * normals[t * 4] + ay * normals[t * 4 + 1] + az * normals[t * 4 + 2];
        tt: f32 := dc / dn;
        if tt > maxt {
            maxt = tt;
        }
    }
    bounds.cone_apex = f32[psphere[0] - ax * maxt, psphere[1] - ay * maxt, psphere[2] - az * maxt];
    bounds.cone_axis = f32[ax, ay, az];
    one: f32 := 1.0;
    cc: f32 := one - mindp * mindp;
    cutoff: f32 := cc.sqrt();
    bounds.cone_cutoff = cutoff;
    q0 := quantize_snorm(ax, 8);
    q1 := quantize_snorm(ay, 8);
    q2 := quantize_snorm(az, 8);
    bounds.cone_axis_s8 = i64[q0, q1, q2];
    s127: f32 := 127.0;
    e0: f32 := (f32(q0) / s127 - ax).abs();
    e1: f32 := (f32(q1) / s127 - ay).abs();
    e2: f32 := (f32(q2) / s127 - az).abs();
    q := i64(s127 * (cutoff + e0 + e1 + e2) + one);
    if 127 < q {
        bounds.cone_cutoff_s8 = 127;
    } else {
        bounds.cone_cutoff_s8 = q;
    }
    return bounds;
}

// meshopt_computeMeshletBounds: meshlet-local vertices and triangles (byte indices into vertices).
pub fn compute_meshlet_bounds<a, b, c>(vertices: (&a u64[]), triangles: (&b u8[]), triangle_count: u64, positions: (&c f32[]), stride: u64) -> Bounds {
    mut indices = u64[];
    mut corner_count: u64 = 0;
    for i in triangle_count * 3 {
        t := triangles[i];
        indices.push(vertices[t]);
        if corner_count <= t {
            corner_count = t + 1;
        }
    }
    mut corners = u64[];
    for i in corner_count {
        corners.push(vertices[i]);
    }
    return cluster_bounds(&indices, &corners, &positions, stride);
}

// ---- meshlets: meshopt_buildMeshletsSpatial ----

pub struct Meshlet {
    vertex_offset: u64,
    triangle_offset: u64,
    vertex_count: u64,
    triangle_count: u64
}

// Meshlets plus the shared vertex and triangle arrays they index (trimmed to what is used).
pub struct Meshlets {
    meshlets: Meshlet[],
    vertices: u64[],
    triangles: u8[]
}

fn copy_u64<a>(v: (&a u64[])) -> u64[] {
    mut out = u64[];
    for i in v.len() {
        out.push(v[i]);
    }
    return out;
}
fn zeros_u8(n: u64) -> u8[] {
    mut out = u8[];
    for i in n {
        out.push(0);
    }
    return out;
}

pub fn build_meshlets_bound(index_count: u64, max_vertices: u64, max_triangles: u64) -> u64 {
    conservative := max_vertices - 2;
    by_vertices := (index_count + conservative - 1) / conservative;
    by_triangles := (index_count / 3 + max_triangles - 1) / max_triangles;
    if by_vertices > by_triangles {
        return by_vertices;
    }
    return by_triangles;
}

// The state bvhSplit shares across its recursion: boxes (6 floats per face), the three sorted
// axis orders (face_count each), boundary flags, vertex use marks and the parameters.
struct Bvh {
    boxes: f32[],
    axes: u64[],
    boundary: u8[],
    sides: u8[],
    used: i64[],
    indices: u64[],
    face_count: u64,
    max_vertices: u64,
    min_triangles: u64,
    max_triangles: u64,
    fill_weight: f32
}

fn flt_max() -> f32 {
    m: f32 := 340282346638528859811704183484516925440.0;
    return m;
}

// bvhCountVertices over axis k's order[base .. base+count]; per-prefix counts into `out` if asked.
fn count_vertices<a, b>(s: (&a mut Bvh), k: u64, base: u64, count: u64, out: (&b mut u64[]), want: bool) -> u64 {
    mut used_vertices: u64 = 0;
    off := k * s.face_count + base;
    for i in count {
        f := s.axes[off + i];
        a := s.indices[f * 3];
        b := s.indices[f * 3 + 1];
        c := s.indices[f * 3 + 2];
        if s.used[a] < 0 {
            used_vertices += 1;
        }
        if s.used[b] < 0 {
            used_vertices += 1;
        }
        if s.used[c] < 0 {
            used_vertices += 1;
        }
        s.used[a] = 1;
        s.used[b] = 1;
        s.used[c] = 1;
        if want {
            out.push(used_vertices);
        }
    }
    for i in count {
        f := s.axes[off + i];
        s.used[s.indices[f * 3]] = -1;
        s.used[s.indices[f * 3 + 1]] = -1;
        s.used[s.indices[f * 3 + 2]] = -1;
    }
    return used_vertices;
}

fn pack_leaf<a>(s: (&a mut Bvh), base: u64, count: u64) -> unit {
    s.boundary[base] = 1;
    for i in count - 1 {
        s.boundary[base + 1 + i] = 0;
    }
    return ();
}

fn pack_tail<a>(s: (&a mut Bvh), base: u64, count: u64) -> unit {
    mut i: u64 = 0;
    mut none = u64[];
    while i < count {
        mut chunk = count - i;
        if i + s.max_triangles <= count {
            chunk = s.max_triangles;
        }
        if count_vertices(&mut s, 0, base + i, chunk, &mut none, false) <= s.max_vertices {
            pack_leaf(&mut s, base + i, chunk);
            i += chunk;
            continue;
        }
        third := s.max_vertices / 3;
        pack_leaf(&mut s, base + i, third);
        i += third;
    }
    return ();
}

fn divisible(count: u64, min: u64, max: u64) -> bool {
    if min * 2 <= max {
        return count >= min;
    }
    return count % min <= (count / min) * (max - min);
}

// Running surface areas from the left (areas[0..count]) and from the right (areas[count..2count]).
fn compute_area<a>(s: (&a Bvh), k: u64, base: u64, count: u64) -> f32[] {
    big := flt_max();
    mut lmin = f32[big, big, big];
    mut lmax = f32[0.0 - big, 0.0 - big, 0.0 - big];
    mut rmin = f32[big, big, big];
    mut rmax = f32[0.0 - big, 0.0 - big, 0.0 - big];
    mut left = f32[];
    mut right = f32[];
    off := k * s.face_count + base;
    for i in count {
        fl := s.axes[off + i];
        fr := s.axes[off + count - 1 - i];
        for c in 3 {
            v := s.boxes[fl * 6 + c];
            if v < lmin[c] {
                lmin[c] = v;
            }
            w := s.boxes[fl * 6 + 3 + c];
            if w > lmax[c] {
                lmax[c] = w;
            }
            v2 := s.boxes[fr * 6 + c];
            if v2 < rmin[c] {
                rmin[c] = v2;
            }
            w2 := s.boxes[fr * 6 + 3 + c];
            if w2 > rmax[c] {
                rmax[c] = w2;
            }
        }
        sx := lmax[0] - lmin[0];
        sy := lmax[1] - lmin[1];
        sz := lmax[2] - lmin[2];
        la: f32 := sx * sy + sy * sz + sz * sx;
        left.push(la);
        tx := rmax[0] - rmin[0];
        ty := rmax[1] - rmin[1];
        tz := rmax[2] - rmin[2];
        ra: f32 := tx * ty + ty * tz + tz * tx;
        right.push(ra);
    }
    for i in count {
        left.push(right[i]);
    }
    return left;
}

// bvhPivot; returns (split, cost bits) packed as [split, f32_bits(cost)].
struct PivotArgs {
    count: u64,
    step: u64,
    min: u64,
    max: u64,
    fill: f32,
    maxfill: u64
}

fn pivot<a, b>(areas: (&a f32[]), vertices: (&b u64[]), args: (&a PivotArgs)) -> u64[] {
    count := args.count;
    step := args.step;
    min := args.min;
    max := args.max;
    fill := args.fill;
    maxfill := args.maxfill;
    aligned := (count >= min * 2) && divisible(count, min, max);
    mut end = count - 1;
    if aligned {
        end = count - min;
    }
    one: f32 := 1.0;
    rmaxfill: f32 := one / f32(i64(maxfill));
    mut bestsplit: u64 = 0;
    mut bestcost: f32 = flt_max();
    mut i = min - 1;
    while i < end {
        lsplit := i + 1;
        rsplit := count - (i + 1);
        if (divisible(lsplit, min, max) == false) || (aligned && (divisible(rsplit, min, max) == false)) {
            i += step;
            continue;
        }
        larea := areas[i];
        rarea := areas[(count - 1 - (i + 1)) + count];
        mut cost: f32 = larea * f32(i64(lsplit)) + rarea * f32(i64(rsplit));
        if cost > bestcost {
            i += step;
            continue;
        }
        mut lfill = lsplit;
        mut rfill = rsplit;
        if vertices.len() != 0 {
            lfill = vertices[i];
            rfill = vertices[i];
        }
        lrest := i64(f32(i64(lfill + maxfill - 1)) * rmaxfill) * i64(maxfill) - i64(lfill);
        rrest := i64(f32(i64(rfill + maxfill - 1)) * rmaxfill) * i64(maxfill) - i64(rfill);
        cost += fill * (f32(lrest) * larea + f32(rrest) * rarea);
        if cost < bestcost {
            bestcost = cost;
            bestsplit = i + 1;
        }
        i += step;
    }
    return u64[bestsplit, f32_bits(bestcost)];
}

fn bvh_split<a>(s: (&a mut Bvh), base: u64, count: u64, depth: u64) -> unit {
    mut none = u64[];
    if (count <= s.max_triangles) && (count_vertices(&mut s, 0, base, count, &mut none, false) <= s.max_vertices) {
        pack_leaf(&mut s, base, count);
        return ();
    }
    mut step: u64 = 1;
    if (s.min_triangles == s.max_triangles) && (count > s.max_triangles) {
        step = s.max_triangles;
    }
    mut mint = s.min_triangles;
    if (count <= s.max_triangles) && (s.max_vertices / 3 < s.min_triangles) {
        mint = s.max_vertices / 3;
    }
    mut maxfill = s.max_triangles;
    if count <= s.max_triangles {
        maxfill = s.max_vertices;
    }
    mut bestk: u64 = 3;
    mut bestsplit: u64 = 0;
    mut bestcost: f32 = flt_max();
    for k in 3 {
        areas := compute_area(&s, k, base, count);
        mut vertices = u64[];
        if count <= s.max_triangles {
            count_vertices(&mut s, k, base, count, &mut vertices, true);
        }
        pa := PivotArgs { count: count, step: step, min: mint, max: s.max_triangles, fill: s.fill_weight, maxfill: maxfill };
        r := pivot(&areas, &vertices, &pa);
        axiscost := f32_from_bits(r[1]);
        if (r[0] != 0) && (axiscost < bestcost) {
            bestk = k;
            bestcost = axiscost;
            bestsplit = r[0];
        }
    }
    if (bestk == 3) || (50 <= depth) {
        pack_tail(&mut s, base, count);
        return ();
    }
    // Sides by face; stable partition of the other two axes.
    for i in count {
        f := s.axes[bestk * s.face_count + base + i];
        if i < bestsplit {
            s.sides[f] = 0;
        } else {
            s.sides[f] = 1;
        }
    }
    for k in 3 {
        if k == bestk {
            continue;
        }
        off := k * s.face_count + base;
        mut lefts = u64[];
        mut rights = u64[];
        for i in count {
            f := s.axes[off + i];
            if s.sides[f] == 0 {
                lefts.push(f);
            } else {
                rights.push(f);
            }
        }
        for i in lefts.len() {
            s.axes[off + i] = lefts[i];
        }
        for i in rights.len() {
            s.axes[off + bestsplit + i] = rights[i];
        }
    }
    bvh_split(&mut s, base, bestsplit, depth + 1);
    bvh_split(&mut s, base + bestsplit, count - bestsplit, depth + 1);
    return ();
}

fn radix_key(v: u64) -> u64 {
    mut mask: u64 = 2147483648;
    if (v & 2147483648) != 0 {
        mask = 4294967295;
    }
    return v ^ mask;
}

// Stable sort of 0..n by the float keys, as meshoptimizer's 3x10-bit radix sort (the 2 lowest
// bits ignored, so keys equal above them keep their order).
fn radix_order<a>(keys: (&a f32[]), n: u64) -> u64[] {
    mut order = u64[];
    for i in n {
        order.push(i);
    }
    for pass in 3 {
        shift := pass * 10 + 2;
        mut hist = u64[];
        for i in 1025 {
            hist.push(0);
        }
        for i in n {
            id := (radix_key(f32_bits(keys[i])) >> shift) & 1023;
            hist[id + 1] = hist[id + 1] + 1;
        }
        for i in 1024 {
            hist[i + 1] = hist[i + 1] + hist[i];
        }
        mut next = u64[];
        for i in n {
            next.push(0);
        }
        for i in n {
            f := order[i];
            id := (radix_key(f32_bits(keys[f])) >> shift) & 1023;
            next[hist[id]] = f;
            hist[id] = hist[id] + 1;
        }
        order = next;
    }
    return order;
}

fn append_meshlet<a, b, c>(m: (&a mut Meshlet), tri: (&b u64[]), out: (&c mut Meshlets), used: (&c mut i64[]), limits: (&b u64[]), split: bool) -> bool {
    a := tri[0];
    b := tri[1];
    c := tri[2];
    max_vertices := limits[0];
    max_triangles := limits[1];
    mut extra: u64 = 0;
    if used[a] < 0 {
        extra += 1;
    }
    if used[b] < 0 {
        extra += 1;
    }
    if used[c] < 0 {
        extra += 1;
    }
    mut result = false;
    if (m.vertex_count + extra > max_vertices) || (m.triangle_count >= max_triangles) || split {
        out.meshlets.push(Meshlet { vertex_offset: m.vertex_offset, triangle_offset: m.triangle_offset, vertex_count: m.vertex_count, triangle_count: m.triangle_count });
        for j in m.vertex_count {
            used[out.vertices[m.vertex_offset + j]] = -1;
        }
        m.vertex_offset = m.vertex_offset + m.vertex_count;
        m.triangle_offset = m.triangle_offset + m.triangle_count * 3;
        m.vertex_count = 0;
        m.triangle_count = 0;
        result = true;
    }
    for v in u64[a, b, c] {
        if used[v] < 0 {
            used[v] = i64(m.vertex_count);
            out.vertices.push(v);
            m.vertex_count = m.vertex_count + 1;
        }
    }
    out.triangles.push(u64(used[a]));
    out.triangles.push(u64(used[b]));
    out.triangles.push(u64(used[c]));
    m.triangle_count = m.triangle_count + 1;
    return result;
}

pub fn build_meshlets_spatial<a, b>(indices: (&a u64[]), positions: (&b f32[]), vertex_count: u64, stride: u64, limits: (&a u64[]), fill_weight: f32) -> Meshlets {
    max_vertices := limits[0];
    min_triangles := limits[1];
    max_triangles := limits[2];
    mut result = Meshlets { meshlets: Meshlet[], vertices: u64[], triangles: u8[] };
    index_count := indices.len();
    if index_count == 0 {
        return result;
    }
    fc := index_count / 3;
    mut boxes = f32[];
    mut cent = f32[];
    for i in fc * 3 {
        cent.push(0.0);
    }
    two: f32 := 2.0;
    for i in fc {
        a := indices[i * 3] * stride;
        b := indices[i * 3 + 1] * stride;
        c := indices[i * 3 + 2] * stride;
        mut mins = f32[];
        mut maxs = f32[];
        for k in 3 {
            va := positions[a + k];
            vb := positions[b + k];
            vc := positions[c + k];
            mut lo = vb;
            if va < vb {
                lo = va;
            }
            if vc < lo {
                lo = vc;
            }
            mut hi = vb;
            if va > vb {
                hi = va;
            }
            if vc > hi {
                hi = vc;
            }
            mins.push(lo);
            maxs.push(hi);
            cent[i + fc * k] = (lo + hi) / two;
        }
        for k in 3 {
            boxes.push(mins[k]);
        }
        for k in 3 {
            boxes.push(maxs[k]);
        }
    }
    mut axes = u64[];
    for k in 3 {
        mut keys = f32[];
        for i in fc {
            keys.push(cent[k * fc + i]);
        }
        order := radix_order(&keys, fc);
        for i in fc {
            axes.push(order[i]);
        }
    }
    mut used = i64[];
    for i in vertex_count {
        used.push(-1);
    }
    mut boundary = u8[];
    for i in fc {
        boundary.push(0);
    }
    mut s = Bvh { boxes: boxes, axes: axes, boundary: boundary, used: used, sides: zeros_u8(fc), indices: copy_u64(&indices), face_count: fc, max_vertices: max_vertices, min_triangles: min_triangles, max_triangles: max_triangles, fill_weight: fill_weight };
    bvh_split(&mut s, 0, fc, 0);
    mut meshlet_count: u64 = 0;
    for i in fc {
        meshlet_count += s.boundary[i];
    }
    bound := build_meshlets_bound(index_count, max_vertices, min_triangles);
    mut m = Meshlet { vertex_offset: 0, triangle_offset: 0, vertex_count: 0, triangle_count: 0 };
    mut pending = meshlet_count;
    mut used2 = exchange(&mut s.used, i64[]);
    alimits := u64[max_vertices, max_triangles];
    for i in fc {
        mut split = (i > 0) && (s.boundary[i] == 1);
        if split && (meshlet_count > bound) && (result.meshlets.len() + pending >= bound) {
            split = false;
        }
        f := s.axes[i];
        tri := u64[indices[f * 3], indices[f * 3 + 1], indices[f * 3 + 2]];
        append_meshlet(&mut m, &tri, &mut result, &mut used2, &alimits, split);
        pending -= s.boundary[i];
    }
    if m.triangle_count != 0 {
        result.meshlets.push(m);
    }
    return result;
}

// ---- cluster partitioning: meshopt_partitionClusters ----

// Cluster groups as parallel arrays (ClusterGroup fields).
struct Groups {
    group: i64[],
    next: i64[],
    size: u64[],
    vertices: u64[],
    cx: f32[],
    cy: f32[],
    cz: f32[],
    radius: f32[]
}

struct Adjacency {
    offsets: u64[],
    clusters: u64[],
    shared: u64[]
}

fn merge_bounds<a>(g: (&a mut Groups), t: u64, s: u64) -> unit {
    r1 := g.radius[t];
    r2 := g.radius[s];
    dx := g.cx[s] - g.cx[t];
    dy := g.cy[s] - g.cy[t];
    dz := g.cz[s] - g.cz[t];
    sq: f32 := dx * dx + dy * dy + dz * dz;
    d: f32 := sq.sqrt();
    if d + r1 < r2 {
        g.cx[t] = g.cx[s];
        g.cy[t] = g.cy[s];
        g.cz[t] = g.cz[s];
        g.radius[t] = r2;
        return ();
    }
    if d + r2 > r1 {
        mut k: f32 = 0.0;
        two: f32 := 2.0;
        if d > 0.0 {
            k = (d + r2 - r1) / (two * d);
        }
        g.cx[t] = g.cx[t] + dx * k;
        g.cy[t] = g.cy[t] + dy * k;
        g.cz[t] = g.cz[t] + dz * k;
        g.radius[t] = (d + r2 + r1) / two;
    }
    return ();
}

fn bounds_score<a>(g: (&a Groups), t: u64, s: u64) -> f32 {
    r1 := g.radius[t];
    r2 := g.radius[s];
    dx := g.cx[s] - g.cx[t];
    dy := g.cy[s] - g.cy[t];
    dz := g.cz[s] - g.cz[t];
    sq: f32 := dx * dx + dy * dy + dz * dz;
    d: f32 := sq.sqrt();
    two: f32 := 2.0;
    mut mr: f32 = (d + r2 + r1) / two;
    if d + r1 < r2 {
        mr = r2;
    } else {
        if d + r2 < r1 {
            mr = r1;
        }
    }
    if mr > 0.0 {
        return r1 / mr;
    }
    return 0.0;
}

// Binary min-heap on (id, order), exactly as heapPush/heapPop.
fn heap_push<a, b>(ids: (&a mut u64[]), orders: (&b mut i64[]), id: u64, order: i64) -> unit {
    ids.push(id);
    orders.push(order);
    mut i = ids.len() - 1;
    while (i > 0) && (orders[i] < orders[(i - 1) / 2]) {
        p := (i - 1) / 2;
        ti := ids[i];
        to := orders[i];
        ids[i] = ids[p];
        orders[i] = orders[p];
        ids[p] = ti;
        orders[p] = to;
        i = p;
    }
    return ();
}

fn heap_pop<a, b>(ids: (&a mut u64[]), orders: (&b mut i64[])) -> u64 {
    top := ids[0];
    size := ids.len() - 1;
    ids[0] = ids[size];
    orders[0] = orders[size];
    ids.pop();
    orders.pop();
    mut i: u64 = 0;
    while i * 2 + 1 < size {
        mut j = i * 2 + 1;
        if (j + 1 < size) && (orders[j + 1] < orders[j]) {
            j += 1;
        }
        if orders[j] >= orders[i] {
            break;
        }
        ti := ids[i];
        to := orders[i];
        ids[i] = ids[j];
        orders[i] = orders[j];
        ids[j] = ti;
        orders[j] = to;
        i = j;
    }
    return top;
}

fn rsqrt_count(n: u64) -> f32 {
    one: f32 := 1.0;
    v: f32 := f32(i64(n));
    return one / v.sqrt();
}

// pickGroupToMerge: returns [best_group + 1 (0 = none), best_shared].
fn pick_group<a, b, c>(g: (&a Groups), id: u64, adj: (&b Adjacency), max_size: u64, use_bounds: bool, acc: (&c mut u64[])) -> u64[] {
    group_rsqrt := rsqrt_count(g.vertices[id]);
    mut ci = i64(id);
    while ci >= 0 {
        c := u64(ci);
        mut k = adj.offsets[c];
        while k != adj.offsets[c + 1] {
            other := g.group[adj.clusters[k]];
            if other >= 0 {
                acc[u64(other)] = acc[u64(other)] + adj.shared[k];
            }
            k += 1;
        }
        ci = g.next[c];
    }
    mut best: u64 = 0;
    mut best_score: f32 = 0.0;
    mut best_shared: u64 = 0;
    weight: f32 := 0.4;
    one: f32 := 1.0;
    ci = i64(id);
    while ci >= 0 {
        c := u64(ci);
        mut k = adj.offsets[c];
        while k != adj.offsets[c + 1] {
            other_i := g.group[adj.clusters[k]];
            k += 1;
            if other_i < 0 {
                continue;
            }
            other := u64(other_i);
            if acc[other] == 0 {
                continue;
            }
            shared := acc[other];
            acc[other] = 0;
            if g.size[id] + g.size[other] > max_size {
                continue;
            }
            other_rsqrt := rsqrt_count(g.vertices[other]);
            mut score: f32 = f32(i64(shared)) * (group_rsqrt + other_rsqrt);
            if use_bounds {
                score = score * (one + weight * bounds_score(&g, id, other));
            }
            if score > best_score {
                best = other + 1;
                best_score = score;
                best_shared = shared;
            }
        }
        ci = g.next[c];
    }
    return u64[best, best_shared];
}

fn tail_of<a>(g: (&a Groups), id: u64) -> u64 {
    mut t = id;
    while g.next[t] >= 0 {
        t = u64(g.next[t]);
    }
    return t;
}

fn merge_leaf<a, b>(g: (&a mut Groups), order: (&b u64[]), base: u64, count: u64, sizes: (&b u64[])) -> unit {
    target := sizes[0];
    max_size := sizes[1];
    for i in count {
        id := order[base + i];
        if (g.size[id] == 0) || (g.size[id] >= target) {
            continue;
        }
        mut best_score: f32 = -1.0;
        mut best: u64 = 0;
        for j in count {
            other := order[base + j];
            if (id == other) || (g.size[other] == 0) {
                continue;
            }
            if g.size[id] + g.size[other] > max_size {
                continue;
            }
            score := bounds_score(&g, id, other);
            if score > best_score {
                best_score = score;
                best = other + 1;
            }
        }
        if best != 0 {
            b := best - 1;
            t := tail_of(&g, b);
            g.next[t] = i64(id);
            g.size[b] = g.size[b] + g.size[id];
            g.size[id] = 0;
            merge_bounds(&mut g, b, id);
            g.radius[id] = 0.0;
        }
    }
    return ();
}

fn center_of<a>(g: (&a Groups), id: u64, axis: u64) -> f32 {
    if axis == 0 {
        return g.cx[id];
    }
    if axis == 1 {
        return g.cy[id];
    }
    return g.cz[id];
}

fn merge_spatial<a, b, c>(g: (&a mut Groups), order: (&b mut u64[]), base: u64, count: u64, sizes: (&c u64[]), depth: u64) -> unit {
    max_size := sizes[1];
    leaf: u64 := 8;
    mut total: u64 = 0;
    for i in count {
        total += g.size[order[base + i]];
    }
    if (total <= max_size) || (count <= leaf) {
        merge_leaf(&mut g, &order, base, count, &sizes);
        return ();
    }
    mut mean = f32[0.0, 0.0, 0.0];
    mut vars = f32[0.0, 0.0, 0.0];
    one: f32 := 1.0;
    mut runc: f32 = 1.0;
    mut runs: f32 = 1.0;
    for i in count {
        id := order[base + i];
        for k in 3 {
            p := center_of(&g, id, k);
            delta := p - mean[k];
            mean[k] = mean[k] + delta * runs;
            vars[k] = vars[k] + delta * (p - mean[k]);
        }
        runc = runc + one;
        runs = one / runc;
    }
    mut axis: u64 = 2;
    if (vars[0] >= vars[1]) && (vars[0] >= vars[2]) {
        axis = 0;
    } else {
        if vars[1] >= vars[2] {
            axis = 1;
        }
    }
    split := mean[axis];
    mut m: u64 = 0;
    for i in count {
        v := center_of(&g, order[base + i], axis);
        t := order[base + m];
        order[base + m] = order[base + i];
        order[base + i] = t;
        if v < split {
            m += 1;
        }
    }
    mut middle = m;
    if (middle <= leaf / 2) || (count - middle <= leaf / 2) || (40 <= depth) {
        middle = count / 2;
    }
    merge_spatial(&mut g, &mut order, base, middle, &sizes, depth + 1);
    merge_spatial(&mut g, &mut order, base + middle, count - middle, &sizes, depth + 1);
    return ();
}

// Partitions clusters (each a list of vertex indices; `counts` gives their lengths) into groups of
// about `target` clusters. Positions empty = no spatial information (NULL in C). Returns the
// partition id of each cluster with the partition count appended as the last element.
pub fn partition_clusters<a, b, c>(indices: (&a u64[]), counts: (&a u64[]), positions: (&b f32[]), vertex_count: u64, stride: u64, target: u64) -> u64[] {
    cluster_count := counts.len();
    max_size := target + target / 3;
    // filterClusterIndices: unique vertices per cluster, first-use order.
    mut used = u8[];
    for i in vertex_count {
        used.push(0);
    }
    mut data = u64[];
    mut offsets = u64[];
    mut start: u64 = 0;
    for i in cluster_count {
        offsets.push(data.len());
        for j in counts[i] {
            v := indices[start + j];
            if used[v] == 0 {
                data.push(v);
                used[v] = 1;
            }
        }
        for j in data.len() - offsets[i] {
            used[data[offsets[i] + j]] = 0;
        }
        start += counts[i];
    }
    offsets.push(data.len());
    // buildClusterAdjacency
    mut refc = u64[];
    for i in vertex_count + 1 {
        refc.push(0);
    }
    for k in data.len() {
        refc[data[k] + 1] = refc[data[k] + 1] + 1;
    }
    for i in vertex_count {
        refc[i + 1] = refc[i + 1] + refc[i];
    }
    mut fill = u64[];
    for i in vertex_count {
        fill.push(refc[i]);
    }
    mut refs = u64[];
    for k in data.len() {
        refs.push(0);
    }
    for i in cluster_count {
        mut j = offsets[i];
        while j < offsets[i + 1] {
            v := data[j];
            refs[fill[v]] = i;
            fill[v] = fill[v] + 1;
            j += 1;
        }
    }
    mut adj = Adjacency { offsets: u64[0], clusters: u64[], shared: u64[] };
    mut slots = u64[];
    for i in cluster_count {
        slots.push(18446744073709551615);
    }
    for i in cluster_count {
        base := adj.clusters.len();
        mut count: u64 = 0;
        mut j = offsets[i];
        while j < offsets[i + 1] {
            v := data[j];
            mut k = refc[v];
            while k < refc[v + 1] {
                c := refs[k];
                k += 1;
                if c == i {
                    continue;
                }
                slot := slots[c];
                if (slot < count) && (adj.clusters[base + slot] == c) {
                    adj.shared[base + slot] = adj.shared[base + slot] + 1;
                } else {
                    slots[c] = count;
                    adj.clusters.push(c);
                    adj.shared.push(1);
                    count += 1;
                }
            }
            j += 1;
        }
        adj.offsets.push(base + count);
    }
    // groups
    use_bounds := positions.len() != 0;
    mut g = Groups { group: i64[], next: i64[], size: u64[], vertices: u64[], cx: f32[], cy: f32[], cz: f32[], radius: f32[] };
    mut hids = u64[];
    mut hord = i64[];
    for i in cluster_count {
        g.group.push(i64(i));
        g.next.push(-1);
        g.size.push(1);
        nv := offsets[i + 1] - offsets[i];
        g.vertices.push(nv);
        mut c = f32[0.0, 0.0, 0.0];
        mut r: f32 = 0.0;
        if use_bounds {
            for j in nv {
                p := data[offsets[i] + j] * stride;
                c[0] = c[0] + positions[p];
                c[1] = c[1] + positions[p + 1];
                c[2] = c[2] + positions[p + 2];
            }
            if nv != 0 {
                n: f32 := f32(i64(nv));
                c[0] = c[0] / n;
                c[1] = c[1] / n;
                c[2] = c[2] / n;
            }
            mut rsq: f32 = 0.0;
            for j in nv {
                p := data[offsets[i] + j] * stride;
                ex := positions[p] - c[0];
                ey := positions[p + 1] - c[1];
                ez := positions[p + 2] - c[2];
                d2: f32 := ex * ex + ey * ey + ez * ez;
                if rsq < d2 {
                    rsq = d2;
                }
            }
            r = rsq.sqrt();
        }
        g.cx.push(c[0]);
        g.cy.push(c[1]);
        g.cz.push(c[2]);
        g.radius.push(r);
        heap_push(&mut hids, &mut hord, i, i64(nv));
    }
    mut acc = u64[];
    for i in cluster_count {
        acc.push(0);
    }
    while hids.len() != 0 {
        top := heap_pop(&mut hids, &mut hord);
        if g.size[top] == 0 {
            continue;
        }
        mut ci = i64(top);
        while ci >= 0 {
            g.group[u64(ci)] = -1;
            ci = g.next[u64(ci)];
        }
        if g.size[top] >= target {
            continue;
        }
        pick := pick_group(&g, top, &adj, max_size, use_bounds, &mut acc);
        if pick[0] == 0 {
            continue;
        }
        best := pick[0] - 1;
        best_shared := pick[1];
        t := tail_of(&g, top);
        g.next[t] = i64(best);
        g.size[top] = g.size[top] + g.size[best];
        g.vertices[top] = g.vertices[top] + g.vertices[best];
        if g.vertices[top] > best_shared {
            g.vertices[top] = g.vertices[top] - best_shared;
        } else {
            g.vertices[top] = 1;
        }
        g.size[best] = 0;
        g.vertices[best] = 0;
        if use_bounds {
            merge_bounds(&mut g, top, best);
            g.radius[best] = 0.0;
        }
        ci = i64(top);
        while ci >= 0 {
            g.group[u64(ci)] = i64(top);
            ci = g.next[u64(ci)];
        }
        heap_push(&mut hids, &mut hord, top, i64(g.vertices[top]));
    }
    if use_bounds {
        mut order = u64[];
        for i in cluster_count {
            if g.size[i] != 0 {
                order.push(i);
            }
        }
        sizes := u64[target, max_size];
        n := order.len();
        merge_spatial(&mut g, &mut order, 0, n, &sizes, 0);
    }
    mut out = u64[];
    for i in cluster_count {
        out.push(0);
    }
    mut next_group: u64 = 0;
    for i in cluster_count {
        if g.size[i] == 0 {
            continue;
        }
        mut j = i64(i);
        while j >= 0 {
            out[u64(j)] = next_group;
            j = g.next[u64(j)];
        }
        next_group += 1;
    }
    out.push(next_group);
    return out;
}
