use meshopt;
use fs;
use io;

// Checks compute_cluster_bounds, extract_meshlet_indices and optimize_meshlet_level (levels 0, 1, 3)
// against meshoptimizer (tests/reference/meshlet_utils.cpp -> tests/meshlet_utils_expected.txt).
// Returns the number of failures.

fn read_all<a>(path: &a [u8]) -> u8[] {
    match fs::read(path) {
        d: u8[] => { return d; },
        e: io::Error => { println("cannot read tests/meshlet_utils_expected.txt"); return u8[]; }
    }
}
fn number<a>(text: &a [u8]) -> u64 {
    mut v: u64 = 0;
    mut neg = false;
    for i in text.len() {
        if text[i] == 45 {
            neg = true;
        } else {
            v = v * 10 + (text[i] - 48);
        }
    }
    return v;
}
fn signed<a>(text: &a [u8]) -> i64 {
    if text[0] == 45 {
        return 0 - i64(number(&text[1: text.len()]));
    }
    return i64(number(&text));
}
fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn bounds_ok<a>(b: (&a meshopt::Bounds), f: (&a u8[][])) -> bool {
    floats := f32[b.center[0], b.center[1], b.center[2], b.radius, b.cone_apex[0], b.cone_apex[1], b.cone_apex[2], b.cone_axis[0], b.cone_axis[1], b.cone_axis[2], b.cone_cutoff];
    for i in 11 {
        if f32_bits(floats[i]) != number(&f[i + 1]) {
            return false;
        }
    }
    ints := i64[b.cone_axis_s8[0], b.cone_axis_s8[1], b.cone_axis_s8[2], b.cone_cutoff_s8];
    for i in 4 {
        if ints[i] != signed(&f[i + 12]) {
            return false;
        }
    }
    return true;
}

fn main() -> u64 {
    text := read_all("tests/meshlet_utils_expected.txt");
    mut failures: u64 = 0;
    mut checks: u64 = 0;
    mut pos = f32[];
    mut cluster = u64[];
    mut local_v = u64[];
    mut local_t = u8[];
    mut start: u64 = 0;
    for i in text.len() {
        if text[i] != 10 {
            continue;
        }
        mut f = u8[][];
        mut s = start;
        while s < i {
            mut e = s;
            while (e < i) && (text[e] != 32) {
                e += 1;
            }
            f.push(text[s: e].copy());
            s = e + 1;
        }
        start = i + 1;
        tag := f[0].copy();
        if same(&tag, "pos") {
            pos = f32[];
            for k in number(&f[1]) * 4 {
                pos.push(f32_from_bits(number(&f[k + 2])));
            }
            continue;
        }
        if same(&tag, "cluster") {
            cluster = u64[];
            for k in number(&f[1]) {
                cluster.push(number(&f[k + 2]));
            }
            continue;
        }
        checks += 1;
        mut ok = true;
        if same(&tag, "cbounds") {
            b := meshopt::compute_cluster_bounds(&cluster, &pos, 4);
            ok = bounds_ok(&b, &f);
        }
        if same(&tag, "extract") {
            r := meshopt::extract_meshlet_indices(&cluster);
            vc := number(&f[1]);
            ok = r.vertices.len() == vc;
            for k in vc {
                ok = ok && (r.vertices[k] == number(&f[k + 2]));
            }
            ok = ok && (r.triangles.len() == cluster.len());
            for k in r.triangles.len() {
                ok = ok && (r.triangles[k] == number(&f[vc + 2 + k]));
            }
            local_v = r.vertices.copy();
            local_t = r.triangles.copy();
        }
        if same(&tag, "opt") {
            level := number(&f[1]);
            r := meshopt::optimize_meshlet_level(&local_v, &local_t, level);
            n := r.vertices.len();
            ok = n == local_v.len();
            for k in n {
                ok = ok && (r.vertices[k] == number(&f[k + 2]));
            }
            for k in r.triangles.len() {
                ok = ok && (r.triangles[k] == number(&f[n + 2 + k]));
            }
        }
        if ok == false {
            println("FAIL {} (check {})", tag.text(), checks);
            failures += 1;
        }
    }
    println("{} checks, {} failures", checks, failures);
    return failures;
}
