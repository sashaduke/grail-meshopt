use meshopt;
use collections;
use fs;
use io;

// Checks the simplifier quadric fills (fill_quadrics: face, vertex, edge, fold and attribute
// quadrics, compared as float bit patterns) against meshoptimizer's internals
// (tests/reference/simplify_quadrics.cpp -> tests/simplify_quadrics_expected.txt).

fn read_all<a>(path: &a [u8]) -> u8[] {
    match fs::read(path) {
        d: u8[] => { return d; },
        e: io::Error => { println("cannot read tests/simplify_quadrics_expected.txt"); return u8[]; }
    }
}
fn number<a>(text: &a [u8]) -> u64 {
    mut v: u64 = 0;
    mut neg = false;
    for i in text.len() {
        if text[i] == 45 {
            neg = true;
        } else {
            v = v * 10 + (text[i] - 48);
        }
    }
    return v;
}
fn signed<a>(text: &a [u8]) -> i64 {
    if text[0] == 45 {
        return 0 - i64(number(&text[1: text.len()]));
    }
    return i64(number(&text));
}
fn same<a, b>(x: &a [u8], y: &b [u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}
fn check_bits<a, b>(name: string, got: (&a f32[]), f: (&b u8[][]), at: u64) -> bool {
    for i in got.len() {
        if f32_bits(got[i]) != number(&f[at + i]) {
            println("FAIL {}[{}]: {} want {}", name, i, f32_bits(got[i]), number(&f[at + i]));
            return false;
        }
    }
    return true;
}

fn main() -> u64 {
    text := read_all("tests/simplify_quadrics_expected.txt");
    mut failures: u64 = 0;
    mut checks: u64 = 0;
    mut pos = f32[];
    mut count: u64 = 0;
    mut idx = u64[];
    mut lock = u8[];
    mut start: u64 = 0;
    for i in text.len() {
        if text[i] != 10 {
            continue;
        }
        mut f = u8[][];
        mut s = start;
        while s < i {
            mut e = s;
            while (e < i) && (text[e] != 32) {
                e += 1;
            }
            f.push(text[s: e].copy());
            s = e + 1;
        }
        start = i + 1;
        tag := f[0].copy();
        if same(&tag, "pos") {
            count = number(&f[1]);
            pos = f32[];
            for k in count * 4 {
                pos.push(f32_from_bits(number(&f[k + 2])));
            }
            continue;
        }
        if same(&tag, "idx") {
            idx = u64[];
            for k in number(&f[1]) {
                idx.push(number(&f[k + 2]));
            }
            continue;
        }
        if same(&tag, "lock") {
            lock = u8[];
            for k in number(&f[1]) {
                lock.push(number(&f[k + 2]));
            }
            continue;
        }
        checks += 1;
        options := number(&f[1]);
        n := number(&f[2]);
        mut attrs = f32[];
        for v in count {
            for k in 3 {
                tenth: f32 := 0.1;
                attrs.push(f32(i64((v * 7 + k * 3) % 11)) * tenth);
            }
        }
        weights := f32[0.5, 0.0, 2.0];
        p := meshopt::simplify_prepare(&idx, &pos, count, 4, &lock, options);
        q := meshopt::fill_quadrics(&p, &pos, 4, &attrs, 3, &weights, &lock, options);
        mut ok = (p.vertex_count == n) && (f32_bits(q.scale) == number(&f[3]));
        ok = ok && check_bits("vertex", &q.vertex, &f, 4);
        ok = ok && check_bits("attribute", &q.attribute, &f, 4 + n * 11);
        ok = ok && check_bits("gradient", &q.gradients, &f, 4 + n * 22);
        if ok == false {
            println("FAIL quadrics options={} (check {})", options, checks);
            failures += 1;
        }
    }
    println("{} checks, {} failures", checks, failures);
    return failures;
}
